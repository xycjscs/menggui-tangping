/* 猛鬼宿舍·躺平发育 v0.6 小程序手机端样式（暗色宿舍主题 · 手机优先） */
page {
  background: radial-gradient(1200rpx 700rpx at 20% -10%, #2c2347 0%, #171126 55%, #100b1c 100%);
  color: #e8e2ff;
  font-family: "PingFang SC", sans-serif;
  -webkit-tap-highlight-color: transparent;
}
/* 自定义导航栏：状态栏占位（高度由 JS 注入 statusBar px） */
.status-bar { width: 100%; flex-shrink: 0; }
.screen { min-height: 100vh; box-sizing: border-box; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.safe-top { padding-top: env(safe-area-inset-top); }

/* ===== 通用 ===== */
.icon-btn { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.07);
  color: #fff; font-size: 36rpx; border: 1rpx solid rgba(180,154,255,0.25);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.icon-btn:active { background: rgba(255,255,255,0.16); }
.res-ico { width: 36rpx; height: 36rpx; vertical-align: -6rpx; }
.btn-primary { background: linear-gradient(135deg,#7c5cff,#b49aff); color: #fff; font-weight: 700;
  font-size: 30rpx; padding: 24rpx 48rpx; border-radius: 22rpx; border: none; line-height: 1.4;
  touch-action: manipulation; }
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); }
.btn-primary.disabled { opacity: 0.45; }
.btn-ghost { background: rgba(255,255,255,0.06); color: #c9c0e8; font-size: 26rpx;
  padding: 20rpx 36rpx; border-radius: 22rpx; border: 1rpx solid rgba(180,154,255,0.25);
  touch-action: manipulation; }
.btn-ghost::after { border: none; }
.section-title { font-size: 28rpx; font-weight: 700; color: #c9c0e8; margin-bottom: 20rpx; display: flex; align-items: center; gap: 12rpx; }
.section-sub { font-size: 22rpx; font-weight: 400; color: #8a80a8; }
.toast { position: fixed; left: 50%; top: calc(env(safe-area-inset-top) + 110rpx); transform: translateX(-50%);
  background: rgba(20,15,34,0.96); border: 1rpx solid rgba(180,154,255,0.4); color: #fff;
  font-size: 26rpx; padding: 20rpx 40rpx; border-radius: 44rpx; z-index: 999; max-width: 86vw; text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.5); }

/* ================= 首页 ================= */
.screen-home { padding: 28rpx 32rpx 48rpx; }
.home-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.home-title { display: flex; align-items: center; gap: 20rpx; }
.home-logo { width: 104rpx; height: 104rpx; }
.home-h1 { font-size: 46rpx; font-weight: 800; letter-spacing: 2rpx; color: #fff; }
.home-sub { font-size: 22rpx; color: #8a80a8; }
.wallet { display: flex; align-items: center; gap: 28rpx; background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(180,154,255,0.2); border-radius: 24rpx; padding: 24rpx 28rpx; margin-bottom: 32rpx; }
.wallet .res { display: flex; align-items: center; gap: 12rpx; font-size: 36rpx; font-weight: 700; }
.wallet-claim { margin-left: auto; font-size: 26rpx; font-weight: 700; padding: 16rpx 26rpx; border-radius: 18rpx;
  background: linear-gradient(135deg,#ff8a3d,#ffd75e); color: #3a2400; }
.home-section { margin-bottom: 32rpx; }
.level-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.level-card { width: calc(50% - 10rpx); box-sizing: border-box; background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(180,154,255,0.22); border-radius: 24rpx; padding: 24rpx 22rpx 20rpx; }
.level-card:active { background: rgba(255,255,255,0.1); }
.level-card.done { border-color: rgba(120,255,150,0.35); }
.level-card.locked { opacity: 0.55; }
.level-id { font-size: 20rpx; color: #8a80a8; margin-bottom: 6rpx; }
.level-name { font-size: 30rpx; font-weight: 700; margin-bottom: 4rpx; }
.level-sub { font-size: 22rpx; color: #9a92b8; }
.level-stars { margin-top: 14rpx; font-size: 30rpx; letter-spacing: 4rpx; }
.star { color: #4a4364; }
.star.on { color: #ffd75e; }
.star.big { font-size: 60rpx; letter-spacing: 12rpx; }
.level-lock { margin-top: 12rpx; font-size: 20rpx; color: #8a80a8; }
.home-ad-row { display: flex; gap: 20rpx; }
.ad-card { flex: 1; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(180,154,255,0.22);
  border-radius: 24rpx; padding: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.ad-card:active { background: rgba(255,255,255,0.1); }
.ad-ico { width: 56rpx; height: 56rpx; }
.ad-name { font-size: 28rpx; font-weight: 700; }
.ad-sub { font-size: 20rpx; color: #9a92b8; }
.footer { margin-top: 32rpx; font-size: 20rpx; color: #6a6288; text-align: center; }

/* ================= 进入页 ================= */
.screen-entry { padding: 28rpx 32rpx 48rpx; }
.back-btn { display: inline-block; background: rgba(255,255,255,0.07); color: #c9c0e8;
  border: 1rpx solid rgba(180,154,255,0.25); padding: 16rpx 32rpx; border-radius: 16rpx; font-size: 28rpx; margin-bottom: 28rpx; }
.entry-card { background: rgba(255,255,255,0.05); border: 1rpx solid rgba(180,154,255,0.25);
  border-radius: 32rpx; padding: 40rpx 32rpx; }
.entry-badge { display: inline-block; font-size: 22rpx; font-weight: 700; color: #b49aff;
  background: rgba(124,92,255,0.15); border: 1rpx solid rgba(124,92,255,0.4); padding: 6rpx 22rpx; border-radius: 32rpx; margin-bottom: 18rpx; }
.entry-h2 { font-size: 46rpx; font-weight: 800; margin-bottom: 8rpx; }
.entry-sub { color: #9a92b8; font-size: 26rpx; margin-bottom: 24rpx; }
.entry-goal { font-size: 28rpx; background: rgba(124,92,255,0.12); border: 1rpx solid rgba(124,92,255,0.3);
  border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.entry-goal .hl { color: #ffd75e; font-weight: 700; }
.entry-stars { margin-bottom: 24rpx; }
.entry-row { margin-top: 28rpx; }
.entry-row-label { font-size: 24rpx; font-weight: 700; color: #c9c0e8; margin-bottom: 14rpx; }
.entry-init { display: flex; flex-wrap: wrap; gap: 12rpx; }
.init-chip { font-size: 22rpx; background: rgba(255,255,255,0.07); border: 1rpx solid rgba(180,154,255,0.2);
  padding: 10rpx 18rpx; border-radius: 12rpx; }
.support-row { display: flex; gap: 14rpx; }
.support-card { flex: 1; background: rgba(255,255,255,0.05); border: 3rpx solid rgba(180,154,255,0.25);
  border-radius: 20rpx; padding: 20rpx 10rpx; text-align: center; }
.support-card:active { background: rgba(255,255,255,0.1); }
.support-card.picked { border-color: #7dff9a; background: rgba(125,255,154,0.1); }
.support-ico { width: 52rpx; height: 52rpx; }
.support-name { font-size: 26rpx; font-weight: 700; margin-top: 8rpx; }
.support-desc { font-size: 18rpx; color: #9a92b8; margin-top: 4rpx; }
.elite-row { border: 2rpx dashed rgba(255,215,94,0.4); border-radius: 20rpx; padding: 22rpx; background: rgba(255,215,94,0.05); }
.elite-row:active { background: rgba(255,215,94,0.1); }
.elite-row.elite-on { border-color: #7dff9a; background: rgba(125,255,154,0.08); }
.elite-info { display: flex; align-items: center; gap: 20rpx; font-size: 24rpx; }
.elite-cost { color: #ffd75e; font-weight: 700; }
.elite-gain { color: #9a92b8; font-size: 22rpx; }
.entry-go { width: 100%; margin-top: 36rpx; font-size: 34rpx; padding: 30rpx; }
.entry-warn { margin-top: 18rpx; font-size: 20rpx; color: #8a80a8; text-align: center; }

/* ================= 游戏屏（画面为主） ================= */
.screen-game { min-height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.game-topbar { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 24rpx;
  background: rgba(8,6,14,0.6); border-bottom: 1rpx solid rgba(150,120,255,0.2); flex-shrink: 0; }
.game-exit { width: 64rpx; height: 64rpx; font-size: 30rpx; }
.game-top-title { font-size: 30rpx; color: #e8e2ff; }
.gt-name { margin-right: 14rpx; font-weight: 700; }
.gt-prog { font-size: 24rpx; color: #ffd75e; }
.game-top-res { display: flex; align-items: center; gap: 8rpx; font-size: 30rpx; font-weight: 700; }
.game-top-res:last-child { margin-left: auto; }
.battle-stage { position: relative; width: 100%; margin: 16rpx auto 0; border-radius: 24rpx; overflow: hidden;
  border: 2rpx solid rgba(150,120,255,0.35); box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.55); background: #181128;
  flex-shrink: 0; }
/* canvas 宽度 100%，高度由 JS 按 750:430 注入 px，保证不变形 */
.battle-canvas { display: block; width: 100%; }
.battle-hint { position: absolute; left: 50%; bottom: 14rpx; transform: translateX(-50%);
  font-size: 20rpx; color: rgba(255,255,255,0.55); background: rgba(8,6,14,0.55);
  padding: 6rpx 22rpx; border-radius: 32rpx; pointer-events: none; white-space: nowrap; transition: opacity 0.5s; }
.battle-hint.hide { opacity: 0; }

/* ===== 底部图标状态坞（纯图标+数字，贴 Home Indicator） ===== */
.dock { margin-top: auto; display: flex; gap: 16rpx; padding: 16rpx 24rpx 12rpx; flex-shrink: 0; }
.dock-cell { flex: 1; background: rgba(255,255,255,0.06); border: 2rpx solid rgba(150,120,255,0.28);
  border-radius: 20rpx; padding: 16rpx 8rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  min-height: 96rpx; box-sizing: border-box; }
.dock-cell:active { background: rgba(124,92,255,0.28); }
.dock-ico { font-size: 40rpx; line-height: 1.1; }
.dock-num { font-size: 22rpx; font-weight: 700; color: #cfc6e8; }
.dock-cell.off { opacity: 0.45; }
.dock-cell.low { border-color: rgba(255,90,120,0.7); background: rgba(255,90,120,0.1); }
.dock-cell.low .dock-num { color: #ff7a94; }

/* ===== 点触菜单 ===== */
.tap-menu { position: fixed; width: 380rpx; z-index: 60;
  background: rgba(20,15,34,0.97); border: 3rpx solid rgba(180,154,255,0.5);
  border-radius: 24rpx; padding: 24rpx 28rpx; box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.6); }
.tap-menu-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.tap-menu-desc { font-size: 20rpx; color: #9a92b8; margin-bottom: 14rpx; line-height: 1.4; }
.tap-stat { display: flex; justify-content: space-between; font-size: 22rpx; padding: 4rpx 0; }
.tap-stat-k { color: #8a80a8; }
.tap-stat-v { font-weight: 700; color: #e8e2ff; }
.tap-menu .btn-primary { width: 100%; font-size: 28rpx; padding: 20rpx; margin-top: 8rpx; }
.tap-close { width: 100%; margin-top: 12rpx; font-size: 24rpx; padding: 12rpx; }
/* v0.5 道具插槽选项（2×2 网格，触控友好大格子） */
.slot-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 10rpx; }
.slot-opt { width: calc(50% - 6rpx); box-sizing: border-box; background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(180,154,255,0.3); border-radius: 14rpx; padding: 16rpx 6rpx;
  display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.slot-opt:active { background: rgba(124,92,255,0.28); }
.slot-opt-poor { opacity: 0.45; }
.slot-opt-ico { font-size: 44rpx; line-height: 1.1; }
.slot-opt-name { font-size: 24rpx; font-weight: 700; }
.slot-opt-cost { font-size: 20rpx; color: #ffd75e; }

/* ================= 弹窗 ================= */
.modal-mask { position: fixed; inset: 0; background: rgba(6,4,12,0.78); display: flex;
  align-items: center; justify-content: center; z-index: 100; padding: 48rpx; }
.modal { width: 100%; max-width: 620rpx; background: linear-gradient(180deg,#241c3d,#1a142e);
  border: 1rpx solid rgba(180,154,255,0.35); border-radius: 32rpx; padding: 44rpx 36rpx; text-align: center; }
.modal-title { font-size: 40rpx; font-weight: 800; margin-bottom: 20rpx; }
.modal-title.danger { color: #ff5e7a; }
.modal-line { font-size: 28rpx; color: #c9c0e8; margin-bottom: 28rpx; }
.modal-ghost { width: 132rpx; height: 132rpx; margin-bottom: 14rpx; }
.modal .btn-primary { width: 100%; margin-bottom: 18rpx; font-size: 30rpx; padding: 26rpx; }
.modal .btn-ghost { width: 100%; font-size: 28rpx; }
.win-stars { font-size: 84rpx; letter-spacing: 16rpx; margin-bottom: 14rpx; }
.win-star { color: #4a4364; }
.win-star.on { color: #ffd75e; }
.modal-reward { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 28rpx; }
.rw-chip { font-size: 28rpx; font-weight: 700; background: rgba(255,215,94,0.12);
  border: 1rpx solid rgba(255,215,94,0.4); padding: 12rpx 28rpx; border-radius: 16rpx; color: #ffd75e; }
