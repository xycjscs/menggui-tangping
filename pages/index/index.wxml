<!-- 猛鬼宿舍·躺平发育 v0.4 三屏：首页(关卡/奖励/设置) → 进入页(关卡+支援) → 游戏(战场为主,点哪里弹哪里) -->

<!-- ============ 屏幕1：首页 ============ -->
<view class="screen screen-home" wx:if="{{screen==='home'}}">
  <view class="home-head">
    <view class="home-title">
      <image class="home-logo" src="/images/sprites/ghost_4.png" mode="aspectFit" />
      <view>
        <view class="home-h1">猛鬼宿舍</view>
        <view class="home-sub">躺平发育 · 关卡挑战</view>
      </view>
    </view>
    <view class="icon-btn" bindtap="onGoSettings">⚙️</view>
  </view>

  <view class="wallet">
    <view class="res"><image class="res-ico" src="/images/icons/coin.png" /><text class="res-num">{{walletCoin}}</text></view>
    <view class="res"><image class="res-ico" src="/images/icons/soul.png" /><text class="res-num">{{walletSoul}}</text></view>
    <view class="wallet-claim" bindtap="onDailyBonus">📺 每日福利</view>
  </view>

  <view class="home-section">
    <view class="section-title">选择关卡 <text class="section-sub">通关解锁下一关</text></view>
    <view class="level-grid">
      <view wx:for="{{levels}}" wx:key="id"
            class="level-card {{item.locked?'locked':''}} {{item.stars?'done':''}}"
            data-id="{{item.id}}" bindtap="onLevelTap">
        <view class="level-id">第 {{item.id}} 关</view>
        <view class="level-name">{{item.name}}</view>
        <view class="level-sub">{{item.sub}}</view>
        <view class="level-stars">
          <text wx:for="{{[0,1,2]}}" wx:for-item="si" wx:key="*this"
                class="star {{si < item.stars ? 'on' : ''}}">{{si < item.stars ? '★' : '☆'}}</text>
        </view>
        <view wx:if="{{item.locked}}" class="level-lock">🔒 通关上一关解锁</view>
      </view>
    </view>
  </view>

  <view class="home-section">
    <view class="section-title">广告福利</view>
    <view class="home-ad-row">
      <view class="ad-card" bindtap="onWalletCoin">
        <image class="ad-ico" src="/images/icons/coin.png" /><view class="ad-name">金币红包</view><view class="ad-sub">钱包 +金币</view>
      </view>
      <view class="ad-card" bindtap="onWalletSoul">
        <image class="ad-ico" src="/images/icons/soul.png" /><view class="ad-name">灵魂馈赠</view><view class="ad-sub">钱包 +灵魂</view>
      </view>
    </view>
  </view>
  <view class="footer">猛鬼宿舍·躺平发育 v0.4.0 · 素材 CC0 (Kenney)</view>
</view>

<!-- ============ 屏幕2：进入页 ============ -->
<view class="screen screen-entry" wx:if="{{screen==='entry'}}">
  <view class="back-btn" bindtap="onEntryBack">← 返回</view>
  <view class="entry-card">
    <view class="entry-badge">关卡 {{currentLevel.id}}</view>
    <view class="entry-h2">{{currentLevel.name}}</view>
    <view class="entry-sub">{{currentLevel.sub}}</view>
    <view class="entry-goal">目标：守住宿舍，清除 <text class="hl">{{currentLevel.wave}}</text> 波猛鬼</view>
    <view class="entry-stars">
      <text wx:for="{{[0,1,2]}}" wx:for-item="si" wx:key="*this"
            class="star big {{si < currentLevel.bestStars ? 'on' : ''}}">{{si < currentLevel.bestStars ? '★' : '☆'}}</text>
    </view>

    <view class="entry-row">
      <view class="entry-row-label">初始配置</view>
      <view class="entry-init">
        <text class="init-chip">💰 {{currentLevel.initCoin}}</text>
        <text class="init-chip">🏚 大门 Lv.{{currentLevel.door}}</text>
        <text class="init-chip">🗼 炮塔 Lv.{{currentLevel.turret}}</text>
        <text class="init-chip">🛏 ×{{currentLevel.beds}}</text>
        <text wx:if="{{currentLevel.soul>0}}" class="init-chip">👻 {{currentLevel.soul}}</text>
        <text wx:if="{{currentLevel.heroes}}" class="init-chip">⚔ {{currentLevel.heroes}}</text>
      </view>
    </view>

    <view class="entry-row">
      <view class="entry-row-label">选择入场支援（免费 · 本局限用）</view>
      <view class="support-row">
        <view wx:for="{{supportDefs}}" wx:key="kind"
              class="support-card {{item.kind===supportPick?'picked':''}}"
              data-kind="{{item.kind}}" bindtap="onSupportPick">
          <image class="support-ico" src="/images/{{item.icoDir}}/{{item.icon}}" />
          <view class="support-name">{{item.name}}</view>
          <view class="support-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="entry-row elite-row {{eliteUsed?'elite-on':''}}" bindtap="onEliteTap">
      <view class="entry-row-label">💎 精锐支援（钱包金币 · 开局额外资源）</view>
      <view class="elite-info">
        <text class="elite-cost">💰 {{eliteCost}}</text>
        <text class="elite-gain">开局 +{{eliteGainCoin}} 金币 / +{{eliteGainSoul}} 灵魂</text>
      </view>
    </view>

    <button class="btn-primary entry-go" bindtap="onEntryGo">进入宿舍 →</button>
    <view class="entry-warn">门被打破后可看广告复活（每局限 1 次）；认输则本局作废</view>
  </view>
</view>

<!-- ============ 屏幕3：游戏 ============ -->
<view class="screen screen-game" wx:if="{{screen==='game'}}">
  <view class="game-topbar">
    <view class="icon-btn game-exit" bindtap="onGameExit">☰</view>
    <view class="game-top-title"><text class="gt-name">关卡 {{currentLevel.id}}</text><text class="gt-prog">{{wavesCleared}}/{{currentLevel.wave}} 波</text></view>
    <view class="game-top-res"><image class="res-ico" src="/images/icons/coin.png" /><text>{{coinText}}</text></view>
    <view class="game-top-res"><image class="res-ico" src="/images/icons/soul.png" /><text>{{soulText}}</text></view>
  </view>

  <view class="battle-stage">
    <canvas type="2d" id="battleCanvas" class="battle-canvas" bindtap="onBattleTap"></canvas>
    <view class="battle-hint {{hintHide?'hide':''}}">点元素升级 · 点 ⬡ 放道具</view>
  </view>
</view>

<!-- 点触菜单 -->
<view class="tap-menu" wx:if="{{screen==='game' && tapMenu.show}}" style="left:{{tapMenu.x}}px;top:{{tapMenu.y}}px">
  <view class="tap-menu-title">{{tapMenu.title}}</view>
  <view class="tap-menu-desc">{{tapMenu.desc}}</view>
  <view wx:for="{{tapMenu.stats}}" wx:key="k" class="tap-stat">
    <text class="tap-stat-k">{{item.k}}</text><text class="tap-stat-v">{{item.v}}</text>
  </view>
  <view class="slot-options" wx:if="{{tapMenu.slotOptions.length > 0}}">
    <view wx:for="{{tapMenu.slotOptions}}" wx:key="id"
          class="slot-opt {{item.poor ? 'slot-opt-poor' : ''}}"
          data-id="{{item.id}}" bindtap="onSlotOptTap">
      <view class="slot-opt-ico">{{item.icon}}</view>
      <view class="slot-opt-name">{{item.name}}</view>
      <view class="slot-opt-cost">{{item.cost}}</view>
    </view>
  </view>
  <button class="btn-primary {{tapMenu.disabled?'disabled':''}}" wx:if="{{tapMenu.action}}" bindtap="onTapAction">{{tapMenu.action}}</button>
  <button class="btn-ghost tap-close" bindtap="onTapClose">收起</button>
</view>

<!-- 胜利结算 -->
<view class="modal-mask" wx:if="{{winModal.show}}">
  <view class="modal win-modal">
    <view class="win-stars">
      <text wx:for="{{[0,1,2]}}" wx:for-item="si" wx:key="*this"
            class="win-star {{si < winModal.stars ? 'on' : ''}}">{{si < winModal.stars ? '★' : '☆'}}</text>
    </view>
    <view class="modal-title">🏆 关卡通过！</view>
    <view class="modal-line">{{winModal.line}}</view>
    <view class="modal-reward">
      <text class="rw-chip">💰 +{{winModal.coin}}</text>
      <text class="rw-chip">👻 +{{winModal.soul}}</text>
    </view>
    <button class="btn-primary" wx:if="{{winModal.hasNext}}" bindtap="onWinNext">下一关 →</button>
    <button class="btn-ghost" bindtap="onWinHome">返回首页（再挑战可刷星）</button>
  </view>
</view>

<!-- 门破弹窗 -->
<view class="modal-mask" wx:if="{{defeatModal.show}}">
  <view class="modal">
    <image class="modal-ghost" src="/images/sprites/ghost_4.png" />
    <view class="modal-title danger">👻 大门被撞破！</view>
    <view class="modal-line">{{defeatModal.text}}</view>
    <button class="btn-primary" bindtap="onRevive">📺 看广告立刻复活（每局 1 次）</button>
    <button class="btn-ghost" bindtap="onAcceptDefeat">认输（本局作废，返回首页）</button>
  </view>
</view>

<view class="toast" wx:if="{{toastText}}">{{toastText}}</view>
