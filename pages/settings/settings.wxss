/* 设置页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1626 0%, #221c33 100%);
  padding: 32rpx;
  box-sizing: border-box;
}
.card {
  background: rgba(0,0,0,0.3);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card.danger { border-color: rgba(255,100,100,0.4); }
.card-title { font-size: 30rpx; font-weight: 700; color: #b8aee8; margin-bottom: 16rpx; }
.stat-row {
  display: flex; justify-content: space-between;
  padding: 12rpx 0; font-size: 26rpx; color: #c0b8e0;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.stat-row:last-child { border-bottom: none; }
.btn-reset {
  background: rgba(255,80,80,0.15) !important;
  color: #ff9a9a !important;
  border: 2rpx solid rgba(255,100,100,0.4) !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  line-height: 80rpx !important;
}
.btn-reset::after { border: none; }
.footer { margin-top: 40rpx; text-align: center; font-size: 20rpx; color: #6a6288; }

/* 弹窗 */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.7);
  display: flex; align-items: center; justify-content: center; z-index: 99;
}
.modal {
  width: 560rpx;
  background: linear-gradient(180deg, #2c2545, #221c33);
  border: 2rpx solid rgba(255,120,120,0.4);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
}
.modal-title { font-size: 34rpx; font-weight: 700; color: #ff9a9a; }
.modal-line { font-size: 26rpx; color: #c0b8e0; }
.btn-danger {
  background: linear-gradient(90deg, #e05252, #ff6b6b) !important;
  color: #fff !important; font-size: 28rpx !important;
  border-radius: 20rpx !important; line-height: 84rpx !important;
  width: 100% !important; border: none !important;
}
.btn-danger::after { border: none; }
.btn-ghost {
  background: transparent !important;
  color: #9a92b8 !important; font-size: 24rpx !important;
  border: 2rpx solid rgba(255,255,255,0.15) !important;
  border-radius: 20rpx !important; line-height: 76rpx !important; width: 100% !important;
}
.btn-ghost::after { border: none; }
