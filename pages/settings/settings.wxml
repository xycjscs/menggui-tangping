<view class="page">
  <view class="card">
    <view class="card-title">游戏统计</view>
    <view class="stat-row"><text>玩家等级</text><text>{{stats.level}}</text></view>
    <view class="stat-row"><text>当前波次</text><text>{{stats.wave}}</text></view>
    <view class="stat-row"><text>累计击杀</text><text>{{stats.kills}}</text></view>
    <view class="stat-row"><text>累计金币</text><text>{{stats.totalCoin}}</text></view>
    <view class="stat-row"><text>失败次数</text><text>{{stats.defeats}}</text></view>
  </view>

  <view class="card danger">
    <view class="card-title">危险操作</view>
    <button class="btn-reset" bindtap="onResetTap">重置存档（不可恢复）</button>
  </view>

  <view class="footer">猛鬼宿舍·躺平发育 v0.1.0</view>

  <view class="modal-mask" wx:if="{{showResetConfirm}}">
    <view class="modal" catchtap="">
      <text class="modal-title">确认重置？</text>
      <text class="modal-line">所有进度将清空，无法恢复！</text>
      <button class="btn-danger" bindtap="onResetConfirm">确认重置</button>
      <button class="btn-ghost" bindtap="onResetCancel">取消</button>
    </view>
  </view>
</view>
